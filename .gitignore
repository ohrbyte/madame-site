node_modules/
dist/

# Local copy of the Google Maps API key (window.MAPS_KEY). In CI this file is
# generated into _site/ from the GOOGLE_MAPS_API_KEY repo secret.
maps-key.js

# Large binary intermediates — regenerable / not used by the running site.
# (kept on disk as deliverables; layers rebuild via scripts/delayer.py)
claude-export/
claude-export.zip
assets/layers/
hand-sponge.png
*.psd

# stray/probe files and the delivery bundle
*.tmp
madame-history.bundle

# One-off measurement/probe scripts (scripts/_*.mjs). These are throwaway tools
# written to MEASURE the design vs the live render (strand fitting, pill/logo
# alignment, stroke profiles, screenshot diffs). They are not part of the build
# and nothing at runtime imports them. The real build scripts (no underscore)
# stay tracked.
scripts/_*.mjs

# scratch diagnostic pages
_*.html

# Per-machine Claude Code permissions — not shared, was mistakenly tracked
.claude/settings.local.json
